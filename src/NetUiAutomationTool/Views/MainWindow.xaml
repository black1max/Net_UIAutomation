<Window x:Class="NetUiAutomationTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetUiAutomationTool.ViewModels"
        xmlns:models="clr-namespace:NetUiAutomationTool.Models"
        xmlns:views="clr-namespace:NetUiAutomationTool.Views"
        mc:Ignorable="d"
        Title="WinForms / .NET UI Automation Studio (.NET 10)" 
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI">

    <Window.Resources>
        <views:ObjectToVisibilityConverter x:Key="ObjToVisConverter" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadScenarioCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveScenarioCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshProcessesCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= メインメニュー ================= -->
        <Menu Grid.Row="0" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,3" FontSize="12">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="シナリオの読み込み(_O)..." InputGestureText="Ctrl+O" Command="{Binding LoadScenarioCommand}" />
                <MenuItem Header="シナリオの保存(_S)..." InputGestureText="Ctrl+S" Command="{Binding SaveScenarioCommand}" />
                <Separator />
                <MenuItem Header="アプリケーションの終了(_X)" InputGestureText="Alt+F4" Command="{Binding ExitApplicationCommand}" />
            </MenuItem>
            <MenuItem Header="操作(_E)">
                <MenuItem Header="プロセス一覧の更新(_R)" InputGestureText="F5" Command="{Binding RefreshProcessesCommand}" />
                <MenuItem Header="UIツリーの再読み込み(_T)" Command="{Binding LoadElementTreeCommand}" />
                <MenuItem Header="選択要素のハイライト(_H)" Command="{Binding HighlightSelectedElementCommand}" />
                <Separator />
                <MenuItem Header="シナリオ実行(_P)" Command="{Binding RunScenarioCommand}" />
                <MenuItem Header="シナリオ全クリア(_C)" Command="{Binding ClearStepsCommand}" />
                <Separator />
                <MenuItem Header="生成コードをクリップボードにコピー" Command="{Binding CopyGeneratedCodeCommand}" />
            </MenuItem>
            <MenuItem Header="ツール(_T)">
                <MenuItem Header="スパイモード(_S)" IsCheckable="True" IsChecked="{Binding IsSpyMode}" InputGestureText="Ctrl+F12" />
                <MenuItem Header="UIA3 エンジン (推奨)" IsCheckable="True" IsChecked="{Binding UseUia3}" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="バージョン情報(_A)..." Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ================= 上部ヘッダーバー ================= -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBackgroundBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- タイトル -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#00D2FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="UI Automation Studio" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    <Border Background="#3A4D6B" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text=".NET 10 &amp; FlaUI" FontSize="11" Foreground="#E0E0E0" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- クイックアクション & スパイ機能 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- スパイモード トグルボタン -->
                    <ToggleButton IsChecked="{Binding IsSpyMode}" 
                                  Padding="12,5" Margin="0,0,8,0" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#444" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎯 " />
                                                    <TextBlock Text="{Binding DataContext.SpyStatusText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#D83B01" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Background" Value="#2D3A4F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- UIA3 / UIA2 トグル -->
                    <CheckBox Content="UIA3 Engine" IsChecked="{Binding UseUia3}" Foreground="White" 
                              VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="ON=UIA3 (推奨), OFF=UIA2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= メインコンテンツ (3ペイン) ================= -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <!-- ================= 左ペイン: プロセス一覧 ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="対象プロセス選択" Style="{StaticResource SectionHeader}" />

                    <!-- プロセス検索フィルター -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1" Content="🔄" ToolTip="一覧を更新" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding RefreshProcessesCommand}" Margin="4,0,0,0" Width="30" />
                    </Grid>

                    <!-- プロセスリスト -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TargetProcessInfo}">
                                <StackPanel Margin="2,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="[PID: " FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="] " FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding MainWindowTitle}" Foreground="{StaticResource MutedTextBrush}" 
                                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 接続ボタン -->
                    <Button Grid.Row="3" Content="🔗 プロセスに接続 (アタッチ)" Style="{StaticResource PrimaryButton}" 
                            Command="{Binding AttachProcessCommand}" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ================= 中央ペイン: UIツリー探索 ================= -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UI要素ツリー (Hierarchy)" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="🔍 ハイライト" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding HighlightSelectedElementCommand}" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                        <Button Grid.Column="2" Content="🔄 再読込" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding LoadElementTreeCommand}" Padding="8,4" FontSize="11" />
                    </Grid>

                    <!-- ツリービュー -->
                    <TreeView Grid.Row="1" ItemsSource="{Binding ElementTree}" SelectedItemChanged="TreeView_SelectedItemChanged"
                              BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:AutomationElementNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Border Background="#E8F1FC" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding ControlTypeName}" FontSize="10" Foreground="#005A9E" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding AutomationId, StringFormat=' [ID: {0}]'}" Foreground="#888" FontSize="11" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ================= 右ペイン: 詳細インスペクタ & 操作 & シナリオ ================= -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 上部: 選択中要素の詳細 & アクション操作 -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- タイトル & バッジ -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="コントロール操作 (Direct Action)" Style="{StaticResource SectionHeader}" Margin="0" />
                                <Border Background="#EEF6FF" CornerRadius="3" Padding="6,2" Margin="8,0,0,0"
                                        Visibility="{Binding SelectedNode, Converter={StaticResource ObjToVisConverter}}">
                                    <TextBlock Text="{Binding SelectedNode.ControlTypeName, StringFormat='Type: {0}'}" FontSize="11" Foreground="#0066CC" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="➕ シナリオに追加" Style="{StaticResource AccentButton}" 
                                    Command="{Binding AddSelectedNodeToScenarioCommand}" CommandParameter="Click" Padding="8,3" FontSize="11" />
                        </Grid>

                        <!-- 要素プロパティ一覧グリッド -->
                        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name: " FontWeight="Bold" Foreground="#555" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedNode.Name, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="AutomationId: " FontWeight="Bold" Foreground="#555" Margin="8,0,0,0" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedNode.AutomationId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ClassName: " FontWeight="Bold" Foreground="#555" Margin="0,4,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNode.ClassName, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,4,0,0" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Patterns: " FontWeight="Bold" Foreground="#555" Margin="8,4,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedNode.PatternsSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,4,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bounds: " FontWeight="Bold" Foreground="#555" Margin="0,4,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedNode.BoundingRectangle, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,4,0,0" />
                            </Grid>
                        </Border>

                        <!-- 入力値フィールド -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="入力 / 選択値: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding ActionInputText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </Grid>

                        <!-- 操作ボタングループ -->
                        <WrapPanel Grid.Row="3">
                            <!-- クリック系 -->
                            <Button Content="🖱️ クリック (Invoke)" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding ExecuteClickCommand}" Margin="0,0,6,6" />
                            <Button Content="🖱️🖱️ ダブルクリック" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteDoubleClickCommand}" Margin="0,0,6,6" />
                            
                            <!-- テキスト系 -->
                            <Button Content="✍️ テキスト設定" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteSetTextCommand}" Margin="0,0,6,6" />
                            <Button Content="➕ テキスト追加" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteAppendTextCommand}" Margin="0,0,6,6" />
                            <Button Content="❌ クリア" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteClearTextCommand}" Margin="0,0,6,6" />

                            <!-- トグル・選択系 -->
                            <Button Content="☑️ チェックON" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteCheckCommand}" Margin="0,0,6,6" />
                            <Button Content="⬜ チェックOFF" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteUncheckCommand}" Margin="0,0,6,6" />
                            <Button Content="🔄 トグル" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteToggleCommand}" Margin="0,0,6,6" />
                            <Button Content="🔽 コンボ選択" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteSelectComboCommand}" Margin="0,0,6,6" />
                            <Button Content="🎯 フォーカス" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExecuteFocusCommand}" Margin="0,0,6,6" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 下部: タブ (シナリオビルダー / C#コード生成 / 実行ログ) -->
                <TabControl Grid.Row="1" Margin="4,4,4,0">
                    <!-- タブ1: 自動化シナリオビルダー -->
                    <TabItem Header="📋 シナリオビルダー (Scenario)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- シナリオツールバー -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="▶️ シナリオ実行" Style="{StaticResource AccentButton}" 
                                            Command="{Binding RunScenarioCommand}" Margin="0,0,6,0" />
                                    <Button Content="⏱️ 待機追加" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding AddWaitStepCommand}" Margin="0,0,6,0" />
                                    <Button Content="🗑️ ステップ削除" Style="{StaticResource DangerButton}" 
                                            Command="{Binding RemoveStepCommand}" CommandParameter="{Binding SelectedScenarioStep}" Margin="0,0,6,0" />
                                    <Button Content="全クリア" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding ClearStepsCommand}" Margin="0,0,6,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="💾 保存" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding SaveScenarioCommand}" Margin="0,0,4,0" />
                                    <Button Content="📂 読込" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding LoadScenarioCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- ステップ一覧データグリッド -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ScenarioSteps}" SelectedItem="{Binding SelectedScenarioStep}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding StepNumber}" Width="35" IsReadOnly="True" />
                                    <DataGridComboBoxColumn Header="Action" SelectedItemBinding="{Binding ActionType}" Width="100"
                                                            ItemsSource="{Binding Source={x:Static vm:MainViewModelHelper.ActionTypes}}" />
                                    <DataGridComboBoxColumn Header="Locator" SelectedItemBinding="{Binding LocatorType}" Width="110"
                                                            ItemsSource="{Binding Source={x:Static vm:MainViewModelHelper.LocatorTypes}}" />
                                    <DataGridTextColumn Header="Target ID / Name" Binding="{Binding LocatorValue}" Width="140" />
                                    <DataGridTextColumn Header="Input / Target Value" Binding="{Binding ActionValue}" Width="130" />
                                    <DataGridTextColumn Header="Wait (ms)" Binding="{Binding WaitMilliseconds}" Width="70" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- タブ2: C# コード生成 -->
                    <TabItem Header="💻 C# コード生成 (CodeGen)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="📋 クリップボードにコピー" Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding CopyGeneratedCodeCommand}" Margin="0,0,8,0" />
                                <TextBlock Text="※ FlaUI.UIA3 を使った完全な C# 自動化コードです" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBox Grid.Row="1" Text="{Binding GeneratedCode}" IsReadOnly="True" 
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                     Background="#1E1E1E" Foreground="#D4D4D4"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" Padding="8" BorderThickness="0" />
                        </Grid>
                    </TabItem>

                    <!-- タブ3: 実行ログ -->
                    <TabItem Header="📜 実行ログ (Logs)">
                        <Grid Margin="6">
                            <ListBox ItemsSource="{Binding ActionLogs}" FontFamily="Consolas, Meiryo" FontSize="11"
                                     Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ================= 最下部ステータスバー ================= -->
        <Border Grid.Row="3" Background="#E8E8E8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Foreground="#333" TextTrimming="CharacterEllipsis" />

                <ProgressBar Grid.Column="1" IsIndeterminate="{Binding IsBusy}" Width="120" Height="14" Margin="10,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource ObjToVisConverter}}" />

                <TextBlock Grid.Column="2" Text="Ready" VerticalAlignment="Center" FontSize="12" Foreground="#666" />
            </Grid>
        </Border>
    </Grid>
</Window>
